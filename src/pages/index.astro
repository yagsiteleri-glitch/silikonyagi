---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import blogPosts from '../data/blogPosts.json';

const petrochemProducts = products.filter(p => p.brand === 'petrochem');
const molykoteProducts = products.filter(p => p.brand === 'molykote');
const sprayProducts = products.filter(p => p.brand === '404');
---

<Layout
  title="Silikon Yağı Fiyatları & Çeşitleri | Toptan Endüstriyel Yağlar"
  description="Petrochem, Molykote ve 404 silikon yağı çeşitleri. 50 cSt - 1000 cSt saf silikon yağı, koşu bandı silikonu, Molykote 111 ve 55 silikon greslerde toptan fiyat ve aynı gün stoktan sevkiyat."
>
  <!-- HERO BRAND BANNERS SHOWCASE -->
  <section class="banner-grid-section" aria-label="Markalarımız ve Silikon Yağı Çeşitleri">
    <div class="container">
      <div class="banner-mosaic-showcase">
        <!-- Big Featured Banner: Petrochem & Molykote (Hero) -->
        <article class="banner-hero-main">
          <a href="#petrochem" class="banner-hero-link" aria-label="Petrochem Silikon Yağları Sayfasına Git">
            <div class="banner-hero-bg">
              <img
                src="/images/banners/hero-artoil.jpg"
                alt="Endüstriyel Silikon Yağları"
                width="720"
                height="420"
                loading="eager"
              />
              <div class="hero-overlay-gradient"></div>
            </div>
            <div class="banner-hero-content">
              <div class="hero-tag-row">
                <span class="hero-brand-pill">
                  <i class="fas fa-shield-alt"></i>
                  <span>Yetkili Satış Noktası</span>
                </span>
                <span class="hero-badge-count">{products.length} Çeşit</span>
              </div>
              <h1 class="hero-banner-title">
                Petrochem & Molykote
                <span class="hero-highlight">Silikon Yağları</span>
              </h1>
              <p class="hero-banner-desc">
                %100 saf silikon sıvıları, 350 cSt koşu bandı yağı, Molykote 111 ve 55 silikon bazlı gres çeşitleri.
              </p>
              <div class="hero-features-list">
                <span><i class="fas fa-check-circle"></i> 50 - 1000 cSt</span>
                <span><i class="fas fa-check-circle"></i> Şişe, Teneke & Varil</span>
                <span><i class="fas fa-check-circle"></i> Stoktan Aynı Gün</span>
              </div>
              <div class="hero-cta-btn">
                <span>Ürünleri İncele</span>
                <i class="fas fa-arrow-right"></i>
              </div>
            </div>
            <div class="hero-product-float">
              <img
                src="/images/banners/artoil-banner.png"
                alt="Silikon Yağı Çeşitleri"
                class="hero-float-img"
              />
            </div>
          </a>
        </article>

        <!-- Right Brand Highlights Grid -->
        <div class="banner-mosaic-right">
          <!-- Petrochem Banner -->
          <article class="brand-banner-card card-shell">
            <a href="#petrochem" class="brand-card-link" aria-label="Petrochem Silikon Sıvılarını İncele">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">Petrochem</span>
                    <span class="card-count-badge">{petrochemProducts.length} Ürün</span>
                  </div>
                  <h3 class="card-product-title">Saf Silikon Sıvıları</h3>
                  <p class="card-visc-tag">50 cSt - 1000 cSt & Koşu Bandı</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/products/petrochem-cst-350-silikon-yagi-1-l.png"
                    alt="Petrochem Silikon Yağı"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>

          <!-- Molykote Banner -->
          <article class="brand-banner-card card-mobil">
            <a href="#molykote" class="brand-card-link" aria-label="Molykote Silikon Greslerini İncele">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">Molykote</span>
                    <span class="card-count-badge">{molykoteProducts.length} Ürün</span>
                  </div>
                  <h3 class="card-product-title">Molykote 111 & 55</h3>
                  <p class="card-visc-tag">Vana, Salmastra & O-Ring Gresleri</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/products/molykote-111-compound-silikonlu-gres-100-gr.png"
                    alt="Molykote Silikon Gres"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>

          <!-- 404 Sprey Banner -->
          <article class="brand-banner-card card-castrol">
            <a href="#sprey" class="brand-card-link" aria-label="Silikon Spreyleri İncele">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">404</span>
                    <span class="card-count-badge">Sprey</span>
                  </div>
                  <h3 class="card-product-title">404 Silikon Sprey</h3>
                  <p class="card-visc-tag">500 ml Çok Amaçlı Yağlayıcı</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/products/404-silikon-sprey-kosu-bandi-icin-uygundur-500-ml.png"
                    alt="404 Silikon Sprey"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>

          <!-- Kalıp Ayırıcı Banner -->
          <article class="brand-banner-card card-po">
            <a href="#petrochem" class="brand-card-link" aria-label="Silikon Emülsiyon İncele">
              <div class="card-inner-flex">
                <div class="card-text-col">
                  <div class="card-brand-header">
                    <span class="card-brand-name">Petrochem</span>
                    <span class="card-count-badge">Emülsiyon</span>
                  </div>
                  <h3 class="card-product-title">Kalıp Ayırıcı Emülsiyon</h3>
                  <p class="card-visc-tag">Tekstil, Kauçuk & Plastik Kalıp</p>
                  <span class="card-action-link">
                    <span>Ürünleri İncele</span>
                    <i class="fas fa-arrow-right"></i>
                  </span>
                </div>
                <div class="card-img-col">
                  <img
                    src="/images/products/petrochem-silikon-emulsiyon-5-l.png"
                    alt="Silikon Emülsiyon"
                    class="card-prod-img"
                    loading="lazy"
                  />
                </div>
              </div>
            </a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- PETROCHEM SILIKON YAGLARI -->
  <section id="petrochem" class="brand-catalog-section">
    <div class="container">
      <div class="brand-heading-center">
        <h2 class="section-heading-lg">Petrochem Saf Silikon Yağları & Emülsiyonlar</h2>
        <p class="section-subheading-clean">
          50 cSt, 100 cSt, 350 cSt (koşu bandı yağı), 1000 cSt viskozitelerinde %100 saf polidimetilsiloksan sıvıları.
        </p>
      </div>
      <div class="section-divider-line"></div>

      <div class="product-cards-grid centered-flex-grid">
        {petrochemProducts.map(p => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>

  <!-- MOLYKOTE SILIKON GRES -->
  <section id="molykote" class="brand-catalog-section">
    <div class="container">
      <div class="brand-heading-center">
        <h2 class="section-heading-lg">Molykote Özel Silikonlu Gresler</h2>
        <p class="section-subheading-clean">
          Gıda onaylı Molykote 111 Compound vana yağlayıcı ve Molykote 55 O-Ring silikon gresleri.
        </p>
      </div>
      <div class="section-divider-line"></div>

      <div class="product-cards-grid centered-flex-grid">
        {molykoteProducts.map(p => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>

  <!-- 404 SILIKON SPREY -->
  {sprayProducts.length > 0 && (
    <section id="sprey" class="brand-catalog-section">
      <div class="container">
        <div class="brand-heading-center">
          <h2 class="section-heading-lg">Silikon Sprey ve Yağlayıcılar</h2>
        </div>
        <div class="section-divider-line"></div>

        <div class="product-cards-grid centered-flex-grid">
          {sprayProducts.map(p => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SEO CONTENT ARTICLE -->
  <section class="seo-text-section">
    <div class="container">
      <div class="section-divider-line"></div>
      <div class="seo-content-box">
        <h3>Silikon Yağı Nedir?</h3>
        <p>Silikon yağı, inorganik silikon-oksijen (Si-O) ana zincirine bağlı organik metil gruplarından oluşan, mükemmel termal kararlılığa ve dielektrik özelliklere sahip sentetik bir sıvıdır. -50°C ile +200°C arasındaki geniş sıcaklık aralığında viskozitesini koruyarak mükemmel kaydırıcılık ve su iticilik sağlar.</p>

        <h3>Silikon Yağlarının Başlıca Kullanım Alanları</h3>
        <p>Koşu bantları tabla ve palet yağlaması, plastik ve kauçuk enjeksiyon kalıplarında ayırıcı olarak, tekstil iplik ve kumaş kaydırıcılarında, otomotiv kapı fitillerinde donma ve gıcırtı önlemede ve elektrik yalıtım sıvılarında yaygın olarak tercih edilir.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-subheading-clean {
    color: #64748b;
    font-size: 15px;
    max-width: 680px;
    margin: 8px auto 0;
    line-height: 1.6;
    text-align: center;
  }
  .centered-flex-grid {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    gap: 24px !important;
    max-width: 1280px;
    margin: 0 auto;
  }
  .centered-flex-grid :global(.product-card) {
    flex: 0 0 280px;
    max-width: 320px;
  }
  @media (max-width: 640px) {
    .centered-flex-grid :global(.product-card) {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }
</style>
